NODE_ENV="development"
PORT=3333
FRONTEND_ORIGIN=""
LOG_DIR="./logs"
NODE_TLS_REJECT_UNAUTHORIZED = '0'

CMS_URL=""
API_KEY=""


CLIENT_ID=""
CLIENT_SECRET=""
APP_NAME=""

# Optional - remote CMS schema polling / retries
# SCHEMA_POLL_INTERVAL_MS=300000
# SCHEMA_FETCH_RETRIES=5
# SCHEMA_FETCH_RETRY_DELAY_MS=1000

# Optional - response cache
# CACHE_ENABLED="true"
# CACHE_TTL_MS=300000
# CACHE_MAX_BYTES=50331648
# CACHE_MAX_ENTRY_BYTES=524288

# Analytical database (PostgreSQL)
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD=""
DB_NAME="final_db"
DB_APP_NAME="appdb"
