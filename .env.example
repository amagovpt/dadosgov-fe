# =============================================================================
# dados.gov.pt - Environment Variables
# =============================================================================
# Copy this file to .env.local and adjust values for your environment.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# --- Backend API ---
# Client-side fetches use the relative /api/1 and /api/2 paths, forwarded to
# BACKEND_URL by src/proxy.ts (no variable needed).

# Absolute backend URL (server-side only, read at runtime). src/proxy.ts forwards
# /api, /saml, /s, /swaggerui and the email-link routes here on every request,
# so it is set per environment at container start, never at build time.
BACKEND_URL=http://localhost:7000

# NOTE: no PROXY_CLIENT_MAX_BODY_SIZE here. Resource uploads are chunked
# client-side (parts of uiConfig.resourceFileUploadChunk = 2MB), so no request
# through the `/api/*` proxy forward exceeds the chunk size — under Next's 10MB
# default. CAVEAT: if you raise resourceFileUploadChunk above 10MB, set
# `experimental.proxyClientMaxBodySize` in next.config.ts (>= the chunk size)
# and raise nginx `client_max_body_size` to match where the proxy is in the path.

# --- Feature flags ---
# Show the Autenticação.gov (SAML) login button. Despite the NEXT_PUBLIC_ prefix
# it is read at runtime (src/config/runtimeConfig.ts) and handed to the browser
# by RuntimeConfigProvider, so it is set at container start, not at build.
NEXT_PUBLIC_SAML_ENABLED=true

# CMS and Data address. Still inlined at build time (NEXT_PUBLIC_).
NEXT_PUBLIC_API_URL=http://localhost:3333

# --- Google reCAPTCHA v3 ---
# The frontend uses react-google-recaptcha-v3 (invisible, score-based — no checkbox).
# Get keys at https://www.google.com/recaptcha/admin (type: "Score based (v3)")
# Note: the v2 test keys do NOT work with v3 — create real v3 keys for each environment.
# If unset, reCAPTCHA is skipped and forms work without it. Read at runtime,
# like NEXT_PUBLIC_SAML_ENABLED.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<site-key>
# Backend also needs the matching v3 secret to verify the token:
GOOGLE_RECAPTCHA_SECRET_KEY=<secret-key>

# --- Tabular preview proxy ---
# The /internal-api/proxy-csv and /internal-api/proxy-spreadsheet routes take a
# resource UUID (not a URL) and stream the bytes through the backend resolver
# `GET /api/1/datasets/r/<id>/` (see BACKEND_URL above). They never reach an
# external host directly, so there is no allowlist to maintain — coverage is the
# whole catalogue and the SSRF boundary lives in the backend download path.

# api-tabular service (server-side only; internal-only in ppr/prd). The
# /internal-api/proxy-tabular-data and /internal-api/proxy-tabular-profile
# routes relay the server-side paginated preview and the csv-detective column
# profile from this host — the browser never reaches it directly (CSP).
# The api-tabular stack runs on its own VM: set this to that VM's address
# (e.g. http://<tabular-vm-ip>:8005). The docker-compose default
# (host.docker.internal:8005) only covers the everything-on-one-host layout;
# if unset/unreachable, the preview silently falls back to the byte proxies.
TABULAR_API_URL=http://localhost:8005