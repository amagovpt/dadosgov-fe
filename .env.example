# =============================================================================
# dados.gov.pt - Environment Variables
# =============================================================================
# Copy this file to .env.local and adjust values for your environment.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# --- Backend API ---
# Relative URLs — client-side fetches go through the Next.js rewrite proxy
NEXT_PUBLIC_API_BASE=/api/1
NEXT_PUBLIC_API_V2_BASE=/api/2

# Absolute backend URL used by next.config.ts rewrites (server-side only)
BACKEND_URL=http://localhost:7000

# --- Feature flags ---
# Show the Autenticação.gov (SAML) login button
NEXT_PUBLIC_SAML_ENABLED=true
NEXT_PUBLIC_API_URL=http://localhost:3333

# --- Google reCAPTCHA v2 ---
# Get keys at https://www.google.com/recaptcha/admin (type: "Challenge (v2) - I'm not a robot")
# Test keys (always pass): site=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI / secret=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# If unset, the reCAPTCHA widget is hidden and forms work without it.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
# Backend also needs:
# GOOGLE_RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# --- CSV preview proxy (SSRF allowlist — TICKET-60 / VULN-2079) ---
# Comma-separated list of hosts allowed as `url` parameter of /internal-api/proxy-csv.
# Exact match on `hostname` (without port) or `host:port`. Case-insensitive.
#
# Defenses applied at request time on top of this allowlist:
#   - port restricted to 80/443 (only ports listed explicitly here are allowed
#     beyond the protocol defaults)
#   - hostname resolved via dns.lookup; the resolved IP is REJECTED in
#     production if it falls in RFC1918, loopback (127.x, ::1), link-local
#     (169.254/16, covers cloud metadata 169.254.169.254), CG-NAT (100.64/10),
#     unique-local IPv6 (fc00::/7) or 0.0.0.0
#   - resolved IP is pinned for the actual TCP connect, blocking DNS rebinding
#   - upstream Content-Type must look like CSV/text (text/csv, text/plain,
#     application/csv, application/octet-stream, ...); HTML/JSON responses
#     are rejected with 415 so the proxy is not a generic relay
#   - body streamed with a 1 MiB cap (no full upload into memory)
#   - 3xx redirects are refused at fetch time
#
# OPERATIONAL: in PRD/PPR, list only the public host(s). Never add localhost,
# 127.0.0.1, 0.0.0.0, ::1, RFC1918 ranges (10.x, 172.16-31.x, 192.168.x),
# CG-NAT (100.64-127.x) or cloud metadata (169.254.169.254). Even though the
# IP-resolution step rejects them, the env var should not advertise them.
#
# Defaults to "dados.gov.pt,preprod.dados.gov.pt" when unset.
CSV_PROXY_ALLOWED_HOSTS=dados.gov.pt,preprod.dados.gov.pt

# Allow http:// URLs (default false = https-only). Set true only in local/DEV/TST
# where the backend is served over plain http. Must stay false in PPR and PRD.
CSV_PROXY_ALLOW_HTTP=false
