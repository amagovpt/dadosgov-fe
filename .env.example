# =============================================================================
# dados.gov.pt - Environment Variables
# =============================================================================
# Copy this file to .env.local and adjust values for your environment.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# --- Backend API ---
# Relative URLs — client-side fetches go through the Next.js rewrite proxy
NEXT_PUBLIC_API_BASE=/api/1
NEXT_PUBLIC_API_V2_BASE=/api/2

# Absolute backend URL used by next.config.ts rewrites (server-side only)
BACKEND_URL=http://localhost:7000

# --- Feature flags ---
# Show the Autenticação.gov (SAML) login button
NEXT_PUBLIC_SAML_ENABLED=true
NEXT_PUBLIC_API_URL=http://localhost:3333

# --- Google reCAPTCHA v3 ---
# The frontend uses react-google-recaptcha-v3 (invisible, score-based — no checkbox).
# Get keys at https://www.google.com/recaptcha/admin (type: "Score based (v3)")
# Note: the v2 test keys do NOT work with v3 — create real v3 keys for each environment.
# If unset, reCAPTCHA is skipped and forms work without it.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<site-key>
# Backend also needs the matching v3 secret to verify the token:
GOOGLE_RECAPTCHA_SECRET_KEY=<secret-key>

# --- Tabular preview proxy (SSRF allowlist) ---
# Governs both /internal-api/proxy-csv (CSV/TSV) and
# /internal-api/proxy-spreadsheet (XLS/XLSX/ODS).
# Exact match on `hostname` (without port) or `host:port`. Case-insensitive.
# Defaults to "dados.gov.pt,preprod.dados.gov.pt" when unset.
# Includes dados.gov.pt's own storage plus the official PT public-sector open-data
# portals that host remote resources (CM Águeda, CM Lisboa, CM Cascais, Turismo de
# Portugal, SNS, CCDR Centro). Add new portals here as they appear in the catalogue.
CSV_PROXY_ALLOWED_HOSTS=dados.gov.pt,preprod.dados.gov.pt,prd-dadosgov.arte.gov.pt,ppr-dadosgov.arte.gov.pt,ckan.sig.cm-agueda.pt,dadosabertos.cm-agueda.pt,dados.cm-lisboa.pt,dadosabertos.cascais.pt,dadosabertos.turismodeportugal.pt,transparencia.sns.gov.pt,formularioincentro.ccdrc.pt,difusaocentroportugal2020.ccdrc.pt

# Allow http:// URLs (default false = https-only). Set true only in local/DEV/TST
# where the backend is served over plain http. Must stay false in PPR and PRD.
CSV_PROXY_ALLOW_HTTP=true