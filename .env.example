# =============================================================================
# dados.gov.pt - Environment Variables
# =============================================================================
# Copy this file to .env.local and adjust values for your environment.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# --- Backend API ---
# Relative URLs — client-side fetches go through the Next.js rewrite proxy
NEXT_PUBLIC_API_BASE=/api/1
NEXT_PUBLIC_API_V2_BASE=/api/2

# Absolute backend URL used by next.config.ts rewrites (server-side only)
BACKEND_URL=http://localhost:7000

# --- Feature flags ---
# Show the Autenticação.gov (SAML) login button
NEXT_PUBLIC_SAML_ENABLED=true
NEXT_PUBLIC_API_URL=http://localhost:3333

# --- CSV preview proxy (SSRF allowlist) ---
# Comma-separated list of hosts allowed as `url` parameter of /internal-api/proxy-csv.
# Exact match on `hostname` or `host` (host includes :port). Case-insensitive.
# SECURITY: in PRD/PPR, only list the public host. Never add localhost, RFC1918
# ranges (10.x, 172.16-31.x, 192.168.x) or cloud metadata IPs (169.254.169.254)
# in a production deployment — that turns this endpoint into an SSRF primitive.
# Defaults to "dados.gov.pt,preprod.dados.gov.pt" when unset.
CSV_PROXY_ALLOWED_HOSTS=dados.gov.pt,preprod.dados.gov.pt

# Allow http:// URLs (default false = https-only). Set true only in local/DEV/TST
# where the backend is served over plain http. Must stay false in PPR and PRD.
CSV_PROXY_ALLOW_HTTP=false
