# =============================================================================
# dados.gov.pt - Environment Variables
# =============================================================================
# Copy this file to .env.local and adjust values for your environment.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# --- Backend API ---
# Relative URLs — client-side fetches go through the Next.js rewrite proxy
NEXT_PUBLIC_API_BASE=/api/1
NEXT_PUBLIC_API_V2_BASE=/api/2

# Absolute backend URL used by next.config.ts rewrites (server-side only)
BACKEND_URL=http://localhost:7000

# Max request body the `/api/*` rewrite proxy streams to the backend (resource
# uploads). Next.js defaults to 10MB, which truncates larger files. Accepts
# "50mb", "1gb" or a raw byte count. In production raise nginx
# `client_max_body_size` to match, or it rejects large uploads first.
PROXY_CLIENT_MAX_BODY_SIZE=100mb

# --- Feature flags ---
# Show the Autenticação.gov (SAML) login button
NEXT_PUBLIC_SAML_ENABLED=true
NEXT_PUBLIC_API_URL=http://localhost:3333

# --- Google reCAPTCHA v3 ---
# The frontend uses react-google-recaptcha-v3 (invisible, score-based — no checkbox).
# Get keys at https://www.google.com/recaptcha/admin (type: "Score based (v3)")
# Note: the v2 test keys do NOT work with v3 — create real v3 keys for each environment.
# If unset, reCAPTCHA is skipped and forms work without it.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<site-key>
# Backend also needs the matching v3 secret to verify the token:
GOOGLE_RECAPTCHA_SECRET_KEY=<secret-key>

# --- Tabular preview proxy ---
# The /internal-api/proxy-csv and /internal-api/proxy-spreadsheet routes take a
# resource UUID (not a URL) and stream the bytes through the backend resolver
# `GET /api/1/datasets/r/<id>/` (see BACKEND_URL above). They never reach an
# external host directly, so there is no allowlist to maintain — coverage is the
# whole catalogue and the SSRF boundary lives in the backend download path.