# =============================================================================
# dados.gov.pt - Environment Variables
# =============================================================================
# Copy this file to .env.local and adjust values for your environment.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# --- Backend API ---
# Relative URLs — client-side fetches go through the Next.js rewrite proxy
NEXT_PUBLIC_API_BASE=/api/1
NEXT_PUBLIC_API_V2_BASE=/api/2

# Absolute backend URL used by next.config.ts rewrites (server-side only)
BACKEND_URL=http://localhost:7000

# --- URLs públicas ---
NEXT_PUBLIC_FRONT_BASE=http://localhost:3000
NEXT_PUBLIC_BASE_URL=https://dados.gov.pt/
NEXT_PUBLIC_STATIC_URL=https://dados.gov.pt/static/

# --- Feature flags ---
NEXT_PUBLIC_READ_ONLY_MODE=false
NEXT_PUBLIC_REQUIRE_EMAIL_CONFIRMATION=true
# Show the Autenticação.gov (SAML) login button
NEXT_PUBLIC_SAML_ENABLED=true

# Tunnel PUT/PATCH/DELETE through POST + X-HTTP-Method-Override header so
# requests can pass the NetScaler ADC WAF rule that blocks non-GET/POST verbs.
# Backend rewrites the method via udata.method_override.MethodOverrideMiddleware
# before Flask routing. Default off for local dev (real verbs work against
# `inv serve`); set true in PPR/PRD where the WAF blocks PUT/PATCH/DELETE.
NEXT_PUBLIC_USE_METHOD_OVERRIDE=true

# --- Integrações opcionais ---
NEXT_PUBLIC_SENTRY_DSN=

# --- API externa (CMS/GraphQL) ---
# URL pública — usada pelo browser (build-time inline no bundle)
NEXT_PUBLIC_API_URL=http://<ip>:3333
# URL interna — usada server-side (Server Components dentro do container Docker)
API_URL_INTERNAL=http://host.docker.internal:3333