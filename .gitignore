# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-test/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# gemini
.gemini/
google-chrome-stable_current_amd64.deb
figma_node.json
# testsprite (vulnerability testing - contains API keys and credentials)
/testsprite_tests/

# tests E2E
test-results/
tests/__pycache__/
playwright-report/
# Bind-mounted log directory (Next.js stdout/stderr piped here by docker-compose)
/logs/*
!/logs/.gitkeep
public/Icons/reduce_icon.svg:Zone.Identifier
*.Identifier
